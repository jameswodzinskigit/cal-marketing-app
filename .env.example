# Server-only Supabase connection. Never expose the service key to index.html.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=replace-with-server-only-service-role-key

# Persistent application authentication settings.
CAL_META_SECRET=replace-with-at-least-32-random-bytes
AGENCY_PIN=replace-with-a-strong-private-pin
CAL_SERVER_USERS_JSON={"admin@example.com":{"pwHash":"replace-with-a-sha256-password-hash","role":"superadmin","calRole":"superadmin","accounts":["company-account-key"],"displayName":"Admin"}}

# Google integrations.
GOOGLE_MAPS_API_KEY=replace-with-a-domain-restricted-key
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=https://your-app.example.com/api/google/callback
